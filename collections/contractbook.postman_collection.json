{
  "info": {
    "name": "Contractbook API v3",
    "description": "Contractbook Public API v3 - contract lifecycle management. Manage documents (contracts), templates, automations, spaces, and attachments, send contracts for e-signature, and receive document life-cycle webhooks. Base URL: https://api.contractbook.com/v3. All requests require a Bearer API key in the Authorization header. Grounded in the official OpenAPI at https://api.contractbook.com/v3/docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.contractbook.com/v3",
      "type": "string"
    },
    {
      "key": "bearerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Documents",
      "item": [
